# Copie como .env fuera del control de versiones. Ningún valor es un secreto real.
DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@HOST_NEON/BASE?sslmode=require
DB_SSLMODE=require

# Servicio local FastAPI <-> kiosk_ui. Genere un secreto independiente.
DEVICE_KEY=
ADMIN_KEY=

# ESP32 NFC: canal directo Raspberry Pi <-> ESP32 NFC.
NFC_ESP32_URL=http://192.168.1.51
NFC_DEVICE_ID=nfc-esp32-01
NFC_HMAC_KEY=
NFC_COMMAND_TTL_SECONDS=30
NFC_CONNECT_TIMEOUT_SECONDS=3
NFC_READ_TIMEOUT_SECONDS=35

# ESP32 de huellas: la ESP32 firma hacia FastAPI con OTRA clave.
FINGERPRINT_DEVICE_ID=fingerprint-esp32-01
FINGERPRINT_HMAC_KEY=
FINGERPRINT_WAIT_SECONDS=75
FINGERPRINT_POLL_SECONDS=1
FINGERPRINT_COMMAND_TIMEOUT_SECONDS=60
DEVICE_MAX_SKEW_SECONDS=120

# Atestación local del proceso facial hacia FastAPI: TERCERA clave.
FACE_ATTESTATION_KEY=
REQUIRE_FACE=true
MAX_FACE_ATTEMPTS=5
SESSION_TIMEOUT_SECONDS=300

# AES-256-GCM: JSON {identificador: clave_base64_de_32_bytes}.
FACE_ENCRYPTION_KEYS={"clave-2026-01":"SUSTITUIR_POR_BASE64_DE_32_BYTES"}
FACE_ACTIVE_KEY_ID=clave-2026-01
FACE_DISTANCE_THRESHOLD=0.55
FACE_AMBIGUITY_MARGIN=0.05
FACE_CAPTURE_SCALE=4
CAMERA_INDEX=0

API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT_SECONDS=8
